<div class="auth-card"><p class="eyebrow">Join the community</p><h1>Create your account</h1>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "stacked-form" }) do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field"><%= form.label :display_name %><%= form.text_field :display_name, autocomplete: "name", required: true, maxlength: 80 %></div>
    <div class="field"><%= form.label :email %><%= form.email_field :email, autocomplete: "email", required: true %></div>
    <div class="field"><%= form.label :bio, "About you (optional)" %><%= form.text_area :bio, rows: 3, maxlength: 1000 %></div>
    <div class="field"><%= form.label :password %><%= form.password_field :password, autocomplete: "new-password", required: true %><% if @minimum_password_length %><small><%= @minimum_password_length %> characters minimum</small><% end %></div>
    <div class="field"><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %></div>
    <%= form.submit "Create account", class: "button button-wide" %>
  <% end %>
  <p class="auth-footer">Already a member? <%= link_to "Sign in", new_session_path(resource_name) %></p>
</div>
